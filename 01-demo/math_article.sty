% ============================================================
%  Layer 1: Global Mathematics Article Design System
%
%  Shared across all mathematical series.
%  No series-specific colors or identity here.
%  All series-dependent values are consumed via
%  \SeriesAccent, \SeriesSecondary, \SeriesTint tokens.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{math_article}[2026/08/12 Mathematics Blog Article System]

% --- Required Packages ---
\RequirePackage[a4paper, margin=1.15in, top=1.0in, bottom=1.2in]{geometry}
\RequirePackage{amsmath, amssymb, amsthm}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage[scaled=0.88]{inconsolata}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{positioning, arrows.meta}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{listings}
\RequirePackage{etoolbox}
\RequirePackage{hyperref}
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{booktabs}

% --- Default Neutral Palette ---
\definecolor{article-bg}{HTML}{FBFAF7}
\definecolor{article-text}{HTML}{202124}
\definecolor{article-muted}{HTML}{686B70}
\definecolor{article-border}{HTML}{DDDCD7}
\definecolor{article-code-bg}{HTML}{F3F3F0}

% --- Series Accent Tokens (defaults, overridden by series .sty) ---
\providecommand{\SeriesAccent}{article-muted}
\providecommand{\SeriesSecondary}{article-muted}
\providecommand{\SeriesTint}{article-code-bg}

% --- Series Metadata Tokens ---
\providecommand{\SeriesName}{Mathematics Series}
\providecommand{\SeriesShortName}{MATH}
\providecommand{\ArticleNumeral}{I}
\providecommand{\ArticleTitle}{Article Title}
\providecommand{\ArticleSubtitle}{}
\providecommand{\ArticleAuthor}{Author}
\providecommand{\ArticleDate}{\today}
\providecommand{\ArticleReadTime}{}
\providecommand{\SeriesMotif}{}

% --- Page Color ---
\pagecolor{article-bg}
\color{article-text}

% --- Hyperref Setup ---
\hypersetup{
  colorlinks=true,
  linkcolor=\SeriesAccent,
  citecolor=\SeriesAccent,
  urlcolor=\SeriesAccent,
  bookmarksnumbered=true,
}

% --- Header / Footer ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{%
  \small\color{article-muted}\thepage%
}
\fancyhead[L]{%
  \small\color{article-muted}\textit{\ArticleAuthor}%
}
\fancyhead[R]{%
  \small\color{article-muted}\SeriesShortName\ \ArticleNumeral%
}

% Redefine plain style (for first page)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small\color{article-muted}\thepage}%
}

% --- Section Formatting ---
\titleformat{\section}
  {\Large\bfseries\sffamily\color{article-text}}
  {\thesection}
  {0.7em}
  {}
  [\vspace{-0.3em}{\color{article-border}\hrule height 0.4pt}\vspace{0.3em}]

\titleformat{\subsection}
  {\large\bfseries\sffamily\color{article-text}}
  {\thesubsection}
  {0.7em}
  {}

\titleformat{\subsubsection}
  {\normalsize\bfseries\sffamily\color{article-text}}
  {\thesubsubsection}
  {0.6em}
  {}

\titlespacing*{\section}{0pt}{2.5em}{1.2em}
\titlespacing*{\subsection}{0pt}{1.8em}{0.8em}
\titlespacing*{\subsubsection}{0pt}{1.2em}{0.5em}

% --- Paragraph ---
\setlength{\parskip}{0.6em}
\setlength{\parindent}{0pt}

% --- Figure Captions ---
\captionsetup{
  font={small, sf},
  labelfont={bf, color=\SeriesAccent},
  labelsep=period,
  justification=centering,
  margin=1.5em,
}

% --- Lists ---
\setlist{
  topsep=0.4em,
  itemsep=0.2em,
  parsep=0.1em,
  leftmargin=1.5em,
}
\setlist[enumerate]{label=(\roman*)}

% --- Code / Listings ---
\lstset{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{article-code-bg},
  frame=single,
  framerule=0.4pt,
  rulecolor=\color{article-border},
  xleftmargin=1em,
  xrightmargin=1em,
  framexleftmargin=0.5em,
  framexrightmargin=0.5em,
  aboveskip=1.2em,
  belowskip=1.0em,
  breaklines=true,
  breakatwhitespace=true,
  numbers=left,
  numberstyle=\tiny\color{article-muted},
  numbersep=8pt,
  showstringspaces=false,
  tabsize=4,
  keywordstyle=\color{\SeriesAccent}\bfseries,
  commentstyle=\color{article-muted}\itshape,
  stringstyle=\color{\SeriesSecondary},
}

% ============================================================
%  Mathematical Environments
%  All share a common tcolorbox base.
%  Accent color comes from \SeriesAccent token.
% ============================================================

% --- Base Style ---
\tcbset{
  math-env-base/.style={
    enhanced,
    breakable,
    left=12pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    boxrule=0pt,
    frame hidden,
    borderline west={2.5pt}{0pt}{#1},
    colback=#1!6!article-bg,
    colframe=#1,
    fonttitle=\sffamily\bfseries\small,
    coltitle=#1,
    attach title to upper={\par\smallskip},
    before upper={\setlength{\parskip}{0.4em}},
  },
  % Lighter variant for remarks/examples
  math-env-light/.style={
    enhanced,
    breakable,
    left=12pt,
    right=12pt,
    top=8pt,
    bottom=8pt,
    boxrule=0pt,
    frame hidden,
    borderline west={2.0pt}{0pt}{article-border},
    colback=article-bg,
    fonttitle=\sffamily\bfseries\small,
    coltitle=article-muted,
    attach title to upper={\par\smallskip},
    before upper={\setlength{\parskip}{0.4em}},
  },
}

% --- Counters ---
\newcounter{mathenv}[section]
\renewcommand{\themathenv}{\thesection.\arabic{mathenv}}

% --- Helper: create a math environment with the accent style ---
\newcommand{\NewMathEnv}[3]{%
  % #1 = environment name
  % #2 = display label (e.g., "Theorem")
  % #3 = color token
  \newtcolorbox[use counter=mathenv]{#1}[1][]{%
    math-env-base={#3},
    title={\MakeUppercase{#2}~\themathenv%
      \ifx\\##1\\\else\quad{\normalfont\itshape\small\color{article-muted}##1}\fi},
  }%
}

\newcommand{\NewMathEnvLight}[3]{%
  \newtcolorbox[use counter=mathenv]{#1}[1][]{%
    math-env-light,
    title={\MakeUppercase{#2}~\themathenv%
      \ifx\\##1\\\else\quad{\normalfont\itshape\small\color{article-muted}##1}\fi},
  }%
}

% Unnumbered variant
\newcommand{\NewMathEnvStar}[3]{%
  \newtcolorbox{#1}[1][]{%
    math-env-base={#3},
    title={\MakeUppercase{#2}%
      \ifx\\##1\\\else\quad{\normalfont\itshape\small\color{article-muted}##1}\fi},
  }%
}

\newcommand{\NewMathEnvLightStar}[3]{%
  \newtcolorbox{#1}[1][]{%
    math-env-light,
    title={\MakeUppercase{#2}%
      \ifx\\##1\\\else\quad{\normalfont\itshape\small\color{article-muted}##1}\fi},
  }%
}

% --- Concrete Environments ---
% These will be created after series .sty loads (via \AtBeginDocument)
% so that \SeriesAccent is correctly resolved.
\AtBeginDocument{%
  % Numbered, accent-colored
  \NewMathEnv{definition}{Definition}{\SeriesAccent}%
  \NewMathEnv{theorem}{Theorem}{\SeriesAccent}%
  \NewMathEnv{proposition}{Proposition}{\SeriesAccent}%
  \NewMathEnv{lemma}{Lemma}{\SeriesAccent}%
  \NewMathEnv{corollary}{Corollary}{\SeriesAccent}%
  %
  % Numbered, light (border only)
  \NewMathEnvLight{remark}{Remark}{article-muted}%
  \NewMathEnvLight{example}{Example}{article-muted}%
  %
  % Unnumbered, secondary color
  \NewMathEnvStar{intuition}{Intuition}{\SeriesSecondary}%
  %
  % Unnumbered, muted
  \NewMathEnvLightStar{technote}{Technical Note}{article-muted}%
}

% --- Proof Environment ---
\renewenvironment{proof}[1][Proof]{%
  \par\smallskip\noindent
  {\sffamily\small\itshape\bfseries\color{article-muted}#1.}\quad\ignorespaces
}{%
  \hfill$\square$\par\smallskip
}

% ============================================================
%  Series Header Component
%
%  Composition: left = information, right = identity.
%  Text is dark. Accent lives in one large tinted shape
%  (top-right, partially clipped) and Brownian motif.
%  No outlines, no decorative lines, no colored text.
%  Title uses serif at moderate weight for monograph feel.
% ============================================================

\newcommand{\MakeSeriesHeader}{%
  \thispagestyle{plain}%
  \begingroup
  %
  % --- Background geometry (TikZ overlay, behind everything) ---
  \begin{tikzpicture}[remember picture, overlay]
    %
    % Geometric background image: top-right corner.
    \node[anchor=north east, inner sep=0pt, opacity=0.85]
      at ([xshift=0.15in, yshift=0.15in] current page.north east)
      {\includegraphics[width=8in]{bg_hexagons.png}};
    %
  \end{tikzpicture}%
  %
  % --- Series label ---
  \noindent
  {\sffamily\fontsize{7.5}{9.5}\selectfont
   \color{article-muted}\MakeUppercase{\SeriesName}}%
  \par\vspace{2.5em}%
  %
  % --- Article title (left) + numeral (right) ---
  \noindent
  \begin{minipage}[b]{0.78\textwidth}
    % Serif title, moderate weight, relaxed leading, no hyphenation.
    \hyphenpenalty=10000
    \exhyphenpenalty=10000
    {\fontsize{21}{27}\selectfont\color{article-text}\ArticleTitle\par}%
  \end{minipage}%
  \hfill
  \begin{minipage}[b]{0.18\textwidth}
    \raggedleft
    % VI: dark, clear, in clean whitespace. No shape behind it.
    {\fontsize{44}{44}\selectfont\color{article-text!80}\ArticleNumeral}%
  \end{minipage}%
  \par\vspace{1.2em}%
  %
  % --- Subtitle ---
  \ifx\ArticleSubtitle\empty\else
    \noindent
    {\itshape\color{article-muted}\ArticleSubtitle\par}%
    \vspace{1.2em}%
  \fi
  %
  % --- Author + metadata (two lines, quiet) ---
  \noindent
  {\normalsize\color{article-text!85}\ArticleAuthor\par}%
  \vspace{0.25em}%
  \noindent
  {\small\color{article-muted}%
    \ArticleDate%
    \ifx\ArticleReadTime\empty\else
      \quad\ArticleReadTime%
    \fi
  \par}%
  \par\vspace{2.0em}%
  %
  % --- Neutral hairline ---
  {\color{article-border}\rule{\textwidth}{0.3pt}}%
  \vspace{2.0em}%
  \endgroup
}

% ============================================================
%  Table of Contents (inline, styled)
% ============================================================
\newcommand{\ArticleTOC}{%
  \begingroup
  \noindent
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=article-border,
    boxrule=0.4pt,
    arc=2pt,
    left=14pt, right=14pt, top=10pt, bottom=10pt,
    fonttitle=\sffamily\footnotesize\bfseries\color{article-muted},
    title={\MakeUppercase{Contents}},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={
      colback=article-bg,
      colframe=article-bg,
      boxrule=0pt,
      left=4pt, right=4pt, top=1pt, bottom=1pt,
    },
  ]
  \small\sffamily
  \@starttoc{toc}
  \end{tcolorbox}
  \vspace{1.5em}
  \endgroup
}

% Redefine TOC line to be clean
\renewcommand{\l@section}[2]{%
  \par\noindent
  \textcolor{\SeriesAccent}{\bfseries\small #2\hspace{0.5em}}%
  {\color{article-text}\small #1}%
  \par\vspace{0.15em}%
}
\renewcommand{\l@subsection}[2]{%
  \par\noindent\hspace{1.5em}%
  {\color{article-muted}\footnotesize #1}%
  \par\vspace{0.05em}%
}

% ============================================================
%  Series Progression Component
% ============================================================
% Usage: \SeriesProgression{active-index}{
%   {I}{Title One},
%   {II}{Title Two},
%   ...
% }
\newcounter{progidx}
\newcommand{\SeriesProgression}[2]{%
  \begingroup
  \vspace{2em}%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=article-border,
    boxrule=0.4pt,
    arc=2pt,
    left=14pt, right=14pt, top=10pt, bottom=10pt,
  ]
  {\sffamily\footnotesize\bfseries\color{article-muted}\MakeUppercase{\SeriesName}}%
  \par\vspace{0.8em}%
  \setcounter{progidx}{0}%
  \@for\@progitem:=#2\do{%
    \stepcounter{progidx}%
    \expandafter\@seriesprogitem\@progitem{#1}%
  }%
  \end{tcolorbox}
  \endgroup
}

\def\@seriesprogitem#1#2#3{%
  \par\noindent
  \ifnum\value{progidx}=#3\relax
    {\sffamily\small\bfseries\color{\SeriesAccent}%
      \makebox[2em][r]{#1}\hspace{0.8em}#2}%
  \else
    {\sffamily\small\color{article-muted}%
      \makebox[2em][r]{#1}\hspace{0.8em}#2}%
  \fi
  \par\vspace{0.2em}%
}

% ============================================================
%  Previous / Next Navigation
% ============================================================
% Usage: \ArticleNav{prev-numeral}{prev-title}{next-numeral}{next-title}
\newcommand{\ArticleNav}[4]{%
  \vspace{2.5em}%
  {\color{article-border}\hrule height 0.4pt}%
  \vspace{1.5em}%
  \noindent
  \begin{minipage}[t]{0.47\textwidth}
    \ifx\\#1\\%
      \relax% no previous
    \else
      {\sffamily\scriptsize\bfseries\color{article-muted}\MakeUppercase{Previous}}\par\vspace{0.3em}%
      {\Large\color{\SeriesAccent!70!article-bg}#1}\par\vspace{0.1em}%
      {\sffamily\small\color{article-text}#2}%
    \fi
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.47\textwidth}
    \raggedleft
    \ifx\\#3\\%
      \relax% no next
    \else
      {\sffamily\scriptsize\bfseries\color{article-muted}\MakeUppercase{Next}}\par\vspace{0.3em}%
      {\Large\color{\SeriesAccent!70!article-bg}#3}\par\vspace{0.1em}%
      {\sffamily\small\color{article-text}#4}%
    \fi
  \end{minipage}%
  \par
}

% ============================================================
%  References styling
% ============================================================
\renewcommand{\refname}{%
  {\sffamily\small\bfseries\color{article-muted}\MakeUppercase{References}}%
}

% --- Suppress \maketitle (use \MakeSeriesHeader instead) ---
\renewcommand{\maketitle}{\MakeSeriesHeader}

\endinput
